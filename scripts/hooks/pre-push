#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/scripts/check-release-clean.sh"
remote_name="${1:?missing remote name}"
zero="0000000000000000000000000000000000000000"
commits=()

add_commit() {
	local candidate="$1"
	local existing
	for existing in "${commits[@]}"; do
		[[ "$existing" == "$candidate" ]] && return
	done
	commits+=("$candidate")
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
	[[ "$local_sha" == "$zero" ]] && continue

	if [[ "$remote_sha" == "$zero" ]]; then
		# Exclude only commits already reachable at the push destination.
		while read -r commit; do
			add_commit "$commit"
		done < <(git rev-list --reverse "$local_sha" --not "--remotes=$remote_name")
	else
		while read -r commit; do
			add_commit "$commit"
		done < <(git rev-list --reverse "$remote_sha..$local_sha")
	fi
done

for commit in "${commits[@]}"; do
	"$checker" --ref "$commit"
done
